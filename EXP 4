#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define SIZE 10

struct employee {
    int id;
    char name[20];
    int salary;
} emp[SIZE];

void Initialize();
void Insert();
void Delete();
void Search();
void Modify();
void Sort();
void Display();

int main() {
    int choice;
    char ans;

    Initialize();

    do {
        printf("\n\n=================================");
        printf("\n       EMPLOYEE DATABASE MENU       ");
        printf("\n=================================");
        printf("\n1. Insert Record");
        printf("\n2. Delete Record");
        printf("\n3. Search Record");
        printf("\n4. Modify Records");
        printf("\n5. Display Records");
        printf("\n6. Sort Records");
        printf("\n7. Exit");
        printf("\n---------------------------------");
        printf("\nEnter your choice (1-7): ");

        if (scanf("%d", &choice) != 1) {
            printf("\nInvalid input!");
            break;
        }

        switch (choice) {
            case 1: Insert(); break;
            case 2: Delete(); break;
            case 3: Search(); break;
            case 4: Modify(); break;
            case 5: Display(); break;
            case 6: Sort(); break;
            case 7: exit(0);
            default: printf("\nInvalid Choice!");
        }

        printf("\n\nDo you want to continue? (y/n): ");
        scanf(" %c", &ans);

    } while (ans == 'y' || ans == 'Y');

    printf("\n\n**** You are out ****\n");
    return 0;
}

void Initialize() {
    int i;
    for (i = 0; i < SIZE; i++) {
        emp[i].id = -1;
        strcpy(emp[i].name, "");
        emp[i].salary = -1;
    }
}

void Insert() {
    int i, slot = -1;

    for (i = 0; i < SIZE; i++) {
        if (emp[i].id == -1) {
            slot = i;
            break;
        }
    }

    if (slot != -1) {
        printf("\nEnter Employee ID: ");
        scanf("%d", &emp[slot].id);
        printf("Enter Name: ");
        scanf("%s", emp[slot].name);
        printf("Enter Salary: ");
        scanf("%d", &emp[slot].salary);
        printf("\nRecord inserted successfully.");
    } else {
        printf("\nDatabase is full!");
    }
}

void Delete() {
    int i, key, flag = 0;
    printf("\nEnter Employee ID to delete: ");
    scanf("%d", &key);

    for (i = 0; i < SIZE; i++) {
        if (emp[i].id == key) {
            emp[i].id = -1;
            strcpy(emp[i].name, "");
            emp[i].salary = -1;
            printf("\nRecord deleted successfully.");
            flag = 1;
            break;
        }
    }

    if (flag == 0) {
        printf("\nRecord not found!");
    }
}

void Search() {
    int i, key, flag = 0;
    printf("\nEnter Employee ID to search: ");
    scanf("%d", &key);

    for (i = 0; i < SIZE; i++) {
        if (emp[i].id == key) {
            printf("\nRecord Found:\nID: %d\nName: %s\nSalary: %d", emp[i].id, emp[i].name, emp[i].salary);
            flag = 1;
            break;
        }
    }

    if (flag == 0) {
        printf("\nRecord not found!");
    }
}

void Modify() {
    int i, key, flag = 0;
    printf("\nEnter Employee ID to modify: ");
    scanf("%d", &key);

    for (i = 0; i < SIZE; i++) {
        if (emp[i].id == key) {
            printf("Enter new Name: ");
            scanf("%s", emp[i].name);
            printf("Enter new Salary: ");
            scanf("%d", &emp[i].salary);
            printf("\nRecord modified successfully.");
            flag = 1;
            break;
        }
    }

    if (flag == 0) {
        printf("\nRecord not found!");
    }
}

void Sort() {
    int i, j;
    struct employee temp;

    for (i = 0; i < SIZE - 1; i++) {
        for (j = 0; j < SIZE - i - 1; j++) {
            if (emp[j].id != -1 && emp[j + 1].id != -1 && emp[j].id > emp[j + 1].id) {
                temp = emp[j];
                emp[j] = emp[j + 1];
                emp[j + 1] = temp;
            }
        }
    }
    printf("\nRecords sorted successfully by Employee ID.");
}

void Display() {
    int i, flag = 0;
    printf("\n--- Employee Records ---");
    for (i = 0; i < SIZE; i++) {
        if (emp[i].id != -1) {
            printf("\nID: %d | Name: %s | Salary: %d", emp[i].id, emp[i].name, emp[i].salary);
            flag = 1;
        }
    }
    if (flag == 0) {
        printf("\nNo records found in database.");
    }
}
